# .gitignore for Maven project
target/
.idea/
.classpath
.project
.settings/
*.iml
*.log
/bin/

# R / RStudio session files
.Rproj.user
.Rhistory
.RData
.Rdata
.Ruserdata

# Generated documentation (rebuilt with mvn javadoc:javadoc / quarto render)
docs/apidocs/
src/site/full-documentation/Units.html

# Simulation output directories written by the shipped configs
/log/
/thesis-log/
/new-thesis-log/
/new-thesis-log2/
/new-thesis-log-newer/
/out/

# Simulator output logs wherever a run drops them (each run writes "<Log> - <run id>.csv")
BeliefLog - *.csv
BlockLog - *.csv
StructureLog - *.csv
EventLog - *.csv
NetLog - *.csv
Nodes - *.csv
Input - *.csv
Config - *.csv
ErrorLog - *.txt
*LatestFileName.txt
