#!/bin/bash
# Runs the packaged simulator with a config file (default: bitcoin.lowrate2).
# Build the jar first with ./comp (or ./do, which builds and then runs this).
# Uses $JAVA_HOME/bin/java when JAVA_HOME is set, i.e. the same JDK that mvn
# uses in ./comp and ./do; otherwise the java on PATH. Needs JDK 21 or newer.
cfg="${1:-src/main/resources/bitcoin-config/bitcoin.lowrate2.application.properties}"
jar=target/cnsim-0.0.1-SNAPSHOT.jar
java_bin="${JAVA_HOME:+$JAVA_HOME/bin/}java"
if [ ! -f "$jar" ]; then
    echo "run: $jar not found; build it with ./comp first" >&2
    exit 1
fi
if [ ! -f "$cfg" ]; then
    echo "run: config file '$cfg' not found" >&2
    exit 1
fi
if ! command -v "$java_bin" >/dev/null 2>&1; then
    echo "run: '$java_bin' is not an executable; point JAVA_HOME at a JDK 21 or newer, or unset it to use the java on PATH" >&2
    exit 1
fi
exec "$java_bin" -jar "$jar" -c "$cfg"
